[sqlfluff]
# DuckDB dialect; lint logic/capitalisation/references only -- sqlfmt owns layout.
# structure.column_order (ST06) excluded: interleaved CAST/CASE columns follow semantic
# ordering from the staging schema contract; reordering would harm readability.
dialect = duckdb
templater = jinja
exclude_rules = layout, structure.column_order
max_line_length = 100
large_file_skip_byte_limit = 0
# Raised from default 255 to accommodate int_mss_bzr_aggregate.sql: two CTEs each with
# a 13-WHEN CASE expression inside a multi-CTE query exceeds the default depth limit.
# 512 is the next power of two above the observed ceiling for this model (B10 #120).
max_parse_depth = 512

[sqlfluff:templater:jinja]
# Stub dbt's ref()/source()/config() so we don't need to compile via dbt.
apply_dbt_builtins = true

[sqlfluff:templater:jinja:macros]
# run_query stub: returns an object with a columns[0][0] accessor that yields 0.
# This makes stg_osm_poi.sql template to the zero-row stub branch, which is valid SQL.
run_query = "{% macro run_query(q) %}{% set ns = namespace() %}{% set ns.result = '' %}{{ ns }}{% endmacro %}"
# QA-4 (#179): stub for the project's canonical_city_code() macro
# (transform/macros/canonical_city_code.sql) so sqlfluff's plain-jinja templater
# (no dbt compile) can parse call sites without a dbt-macro loader.
canonical_city_code = "{% macro canonical_city_code(column) %}case when {{ column }} = 'berlin' then 'BER' else {{ column }} end{% endmacro %}"
# QA-5 (#180): stub for the project's raw_path() macro
# (transform/macros/raw_path.sql) so sqlfluff's plain-jinja templater can parse
# call sites without a dbt-macro loader. Returns a syntactically-valid dummy
# path string; the real value is only needed at dbt-execute time.
raw_path = "{% macro raw_path(relative_path) %}/tmp/raw/{{ relative_path }}{% endmacro %}"
# QA-4b (#202): stub for the project's published_cities_filter() macro
# (transform/macros/published_cities_filter.sql) so sqlfluff's plain-jinja
# templater can parse call sites without a dbt-macro loader. Returns a
# syntactically-valid single-value IN clause; the real published_cities var
# list is only resolved at dbt-execute time.
published_cities_filter = "{% macro published_cities_filter(column) %}{{ column }} in ('BER'){% endmacro %}"
# QA-winsor (#268): stub for the project's winsorize() macro
# (transform/macros/winsorize.sql) so sqlfluff's plain-jinja templater can parse
# call sites without a dbt-macro loader. Returns the expression wrapped in a
# syntactically-valid LEAST/GREATEST clip; the real bound args are only
# resolved at dbt-execute time (default +/-3 matches the macro's default).
winsorize = "{% macro winsorize(expr, lower=-3, upper=3) %}least(greatest({{ expr }}, {{ lower }}), {{ upper }}){% endmacro %}"

[sqlfluff:templater:jinja:context]
# Default value for file_count used in stg_osm_poi.sql graceful-degradation logic.
# SQLFluff templates the else-branch (zero-row stub) which is always valid SQL.
file_count = 0
execute = False
# Stub for generic dbt test macros — 'model' is injected by dbt at runtime.
model = gentriduck__main__test_model

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower
