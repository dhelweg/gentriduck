# Copy to .env (gitignored) and fill in as needed. No secrets are required for local
# DuckDB development; these are only used later for hosting / MotherDuck.

# MotherDuck (F2/#34, ADR-0012 — optional, free-tier warehouse-build convenience target only;
# never on the visitor-facing serving path). Get a token at motherduck.com, then:
#   uv run dbt build --project-dir transform --profiles-dir transform --target md
# MOTHERDUCK_TOKEN=

# dbt: keep the profile repo-local so the global ~/.dbt is untouched.
DBT_PROFILES_DIR=transform
